# 单机数据目录；Windows 推荐使用 C:\\ProgramData\\LieBiao\\data
LIEBIAO_DATA_DIR=
LIEBIAO_HOST=127.0.0.1
LIEBIAO_PORT=8090
LIEBIAO_MAX_ATTACHMENT_MB=500
LIEBIAO_MAX_ARCHIVE_MB=500
LIEBIAO_MAX_EXPANDED_MB=2048
LIEBIAO_MAX_ARCHIVE_FILES=3000
LIEBIAO_MAX_ARCHIVE_DEPTH=3
# 公网更新检查；关闭可填写 false，也可改为其他 HTTPS JSON 清单
LIEBIAO_UPDATE_ENABLED=true
LIEBIAO_UPDATE_URL=https://api.github.com/repos/yanpengyuzhouji/LieBiao/releases/latest
